# API configuration (all values are public and safe to commit)
# Base URL of the Laravel API, including the /api prefix.
VITE_API_BASE_URL=https://api.traininghubtz.co.tz/api

# Optional: where uploaded files (course banners, avatars) are served from.
# Defaults to the API origin + /storage.
# VITE_STORAGE_BASE_URL=https://api.traininghubtz.co.tz/storage

# Optional: dev-server proxy target for requests made to a relative /api path.
# VITE_API_PROXY_TARGET=https://api.traininghubtz.co.tz
